# Neon Postgres — NEW instance for this project only.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Razorpay — activate live only after release gates and test-mode verification.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Resend
RESEND_API_KEY=
MAIL_FROM="Tallywebsolutions <orders@your-domain.com>"

# Secret used to sign download tokens. openssl rand -hex 32
DOWNLOAD_SECRET=

# Optional admin bootstrap credential; never put it in a URL. Prefer ADMIN_EMAIL.
ADMIN_TOKEN=

NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Configurable storefront identity.
NEXT_PUBLIC_STORE_NAME="Tallywebsolutions"

# Legal seller. Must match the Razorpay account holder — Razorpay requires the
# entity receiving payment to be named on the policy pages.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDRESS=
SUPPORT_EMAIL=
SUPPORT_PHONE=

# Verified-email reader and author sessions. Use a random secret of at least 32 bytes.
AUTH_SECRET=
ADMIN_EMAIL=
# Private Vercel Blob store; do not use a public store for paid files/manuscripts.
BLOB_READ_WRITE_TOKEN=
SCAN_WEBHOOK_SECRET=
CRON_SECRET=
# Fail closed until prices, files, email, policies and services have been approved.
COMMERCE_ENABLED=false
COMMERCE_POLICIES_APPROVED=false
ALLOW_DEV_CHECKOUT=false
# Optional first-party storage host allowlist; prefer authenticated private Blob storage.
BOOK_STORAGE_ALLOWED_HOSTS=
